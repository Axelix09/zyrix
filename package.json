{
  "name": "@axel-dev09/zyrix",
  "version": "0.16.0",
  "description": "Biblioteca de WhatsApp Web para Node.js con API por espacios, sesiones cifrables y kit de comandos",
  "author": "Axelix09",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axelix09/zyrix.git"
  },
  "homepage": "https://github.com/Axelix09/zyrix#readme",
  "bugs": {
    "url": "https://github.com/Axelix09/zyrix/issues"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "whatsapp-bot",
    "whatsapp-api",
    "whatsapp-library",
    "whatsapp-multi-device",
    "wa-bot",
    "bot",
    "chatbot",
    "baileys",
    "baileys-alternative",
    "nodejs",
    "esm",
    "websocket",
    "command-handler",
    "command-kit",
    "session-adapter",
    "mongodb",
    "plugins",
    "bot-framework",
    "typescript-types",
    "zyrix",
    "bot-whatsapp",
    "libreria-whatsapp"
  ],
  "files": [
    "src",
    "index.d.ts",
    "client.d.ts",
    "kit.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES",
    "CHANGELOG.md",
    "tests",
    "scripts/check-test-discovery.mjs",
    "type-tests"
  ],
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./kit": {
      "types": "./kit.d.ts",
      "import": "./src/kit.js",
      "default": "./src/kit.js"
    }
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node scripts/check-test-discovery.mjs && node --test",
    "test:run": "node --test",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,DOM --skipLibCheck false type-tests/types-smoke.ts index.d.ts client.d.ts kit.d.ts",
    "types:generate": "tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "@wppconnect/wa-proto": "2.3000.1049217119",
    "libsignal": "6.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.7.3"
  }
}
